{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "looma-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "looma-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "looma-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "start", "-p", "3900"],
      "port": 3900
    }
  ]
}
