# Copied to /opt/sentencestep/active-upstream.caddy on first setup and rewritten by
# deploy.sh / rollback.sh on every deploy. `app-blue` or `app-green` is the live slot.
reverse_proxy app-blue:3000 {
	health_uri /api/health
	health_interval 10s
	health_timeout 3s
	# A slot that is momentarily unreachable is retried for a few seconds instead of
	# turning into an error page for the visitor.
	lb_try_duration 5s
	lb_try_interval 250ms
	# Next streams its HTML and server-component payloads: send each chunk on
	# immediately instead of buffering it.
	flush_interval -1
	transport http {
		dial_timeout 3s
		response_header_timeout 120s
	}
}
