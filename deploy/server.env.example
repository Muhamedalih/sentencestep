# Server-side environment for the site (copied to /opt/sentencestep/server.env,
# permissions 600, owned by `deploy`). Fill in the REAL values on the server only —
# this file in git has names and notes, never secrets.
#
# Take every value from the Netlify project's environment variables (Project
# configuration -> Environment variables) so the two hosts behave identically. The
# list below is .env.example plus the new ORIGIN_AUTH_SECRET.

# --- how the process runs --------------------------------------------------
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=1536

# --- site identity (public values; also passed to the image build) ----------
NEXT_PUBLIC_SITE_URL=https://sentencestep.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- secrets ---------------------------------------------------------------------
# Must equal the value used when the image was built (a different key makes every
# already-open page's server actions fail).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
TURNSTILE_SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The secret Cloudflare stamps into the x-origin-auth header (Transform Rule). The
# app only believes cf-ipcountry / cf-connecting-ip when this matches. 48+ random
# characters; the same value goes into the Cloudflare rule. Never reuse another secret.
ORIGIN_AUTH_SECRET=

# --- payments, email, voices, AI -------------------------------------------------
WAYL_API_KEY=
WAYL_WEBHOOK_SECRET=
WAYL_ENV=live
WAYL_SHOW_USD=
# Binance Pay: the secret the Frankfurt relay signs its requests with (48+ random characters; the
# same value in /etc/looma-relay/relay.env on the relay). Unset = Binance Pay unavailable.
BINANCE_RELAY_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_WEBHOOK_SECRET=
WELCOME_EMAIL_ENABLED=
MILESTONE_EMAILS=
EMAIL_PROVIDER=
EMAIL_RESEND_DAILY_BUDGET=
EMAIL_RESEND_BULK_CEILING=
EMAIL_SES_MONTHLY_BUDGET=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
NUDGE_EMAIL_MAX_PER_RUN=
NUDGE_EMAIL_HOLDOUT_PERCENT=
NUDGE_EMAIL_ALLOW_PASSWORD_ACCOUNTS=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
FISH_AUDIO_API_KEY=
HUME_API_KEY=
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=
VOICE_DIRECTOR_MODEL=
FREE_ACCESS_EXCLUDED_EMAILS=
RATINGS_WEBHOOK_URL=
RATINGS_WEBHOOK_SECRET=

# --- error reporting ------------------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
